{
	"name": "petermarshall.ca-v2",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"build-ipfs": "node scripts/generate-ipfs.js",
		"build-ipni": "node --import=tsx scripts/generate-ipni.ts",
		"build-ipfs-worker": "node --import=tsx scripts/build-ipfs-worker.ts",
		"build-all": "vite build && node scripts/generate-ipfs.js && node --import=tsx scripts/generate-ipni.ts && node --import=tsx scripts/build-ipfs-worker.ts",
		"ipni-provide": "node --import=tsx scripts/provide-ipni.ts",
		"update-dnslink": "node --import=tsx scripts/update-dnslink.ts",
		"publish": "node --import=tsx scripts/provide-ipni.ts && node --import=tsx scripts/update-dnslink.ts && node --import=tsx scripts/provide-amino.ts && node --import=tsx scripts/upload-to-filebase.ts"
	},
	"devDependencies": {
		"@aws-sdk/client-s3": "^3.1121.0",
		"@aws-sdk/lib-storage": "^3.1121.0",
		"@chainsafe/libp2p-noise": "^17.0.0",
		"@chainsafe/libp2p-yamux": "^8.0.1",
		"@cloudflare/workers-types": "^4.20260214.0",
		"@ipld/car": "^5.4.7",
		"@libp2p/bootstrap": "^12.0.30",
		"@libp2p/crypto": "^5.1.13",
		"@libp2p/identify": "^4.1.13",
		"@libp2p/interface": "^3.1.0",
		"@libp2p/kad-dht": "^16.4.4",
		"@libp2p/peer-id": "^6.0.4",
		"@libp2p/ping": "^3.1.12",
		"@libp2p/tcp": "^11.0.27",
		"@libp2p/websockets": "^10.1.20",
		"@libp2p/webtransport": "^6.0.37",
		"@multiformats/multiaddr": "^13.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/enhanced-img": "^0.10.4",
		"@sveltejs/kit": "^2.55.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^25.2.0",
		"blockstore-core": "^7.0.1",
		"broadcastchannel-polyfill": "^1.0.1",
		"cloudflare": "^5.2.0",
		"esbuild": "^0.27.3",
		"glob": "^13.0.0",
		"ipfs-unixfs-importer": "^17.0.1",
		"ipns": "^10.1.3",
		"js-ipni": "^0.0.2",
		"libp2p": "^3.3.9",
		"mdsvex": "^0.12.6",
		"multiformats": "^14.0.5",
		"svelte": "^5.54.1",
		"tsx": "^4.21.0",
		"vite": "^8.0.0"
	}
}
