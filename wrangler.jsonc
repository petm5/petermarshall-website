{
  "name": "petermarshall-ca",
  "compatibility_date": "2026-09-01",
  "main": "dist/ipfs-worker.js",
  "triggers": {
    "crons": [
      "30 1,13 * * *" // 1:30 AM and 1:30 PM (UTC), every day
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DHT_PUBLISHER",
        "class_name": "DhtPublisher"
      }
    ]
  },
  "exports": {
    "DhtPublisher": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "assets": {
    "directory": "build",
    "not_found_handling": "404-page",
  }
}
